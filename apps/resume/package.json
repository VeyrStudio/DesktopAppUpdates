{
  "name": "resume",
  "version": "0.1.3",
  "description": "Resume independent personal photo archive",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/resume-isolation.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "studio.veyr.resume",
    "productName": "Resume",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ResumeSetup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "extraResources": []
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
