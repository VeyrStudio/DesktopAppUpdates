<Window x:Class="TheBookworm.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="580" Height="625" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/TheBookworm.ico" Background="{StaticResource AntiqueGreenGradient}">
    <Border Margin="18" Padding="24" BorderBrush="{StaticResource Gold500Brush}" BorderThickness="1"
            CornerRadius="12" Background="{StaticResource PanelGradient}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="SETTINGS" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gold300Brush}"/>
                <TextBlock Text="Keep Bookworm as simple or study-heavy as you want."
                           Foreground="{StaticResource MutedOliveBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#60163429" BorderBrush="#6D5B37" BorderThickness="1"
                    CornerRadius="9" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Questions &amp; Quizzes" FontSize="17" Foreground="{StaticResource IvoryBrush}"/>
                        <TextBlock Text="Show the Questions and Quizzes tabs and tools inside books."
                                   Foreground="{StaticResource MutedOliveBrush}" FontSize="11"
                                   Margin="0,4,20,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="QuestionsToggle" Grid.Column="1" Style="{StaticResource AntiqueCheckBox}"
                              VerticalAlignment="Center" FontSize="15" Content="On"
                              Checked="QuestionsToggle_Changed" Unchecked="QuestionsToggle_Changed"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#60163429" BorderBrush="#6D5B37" BorderThickness="1"
                    CornerRadius="9" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Automatic Updates" FontSize="17" Foreground="{StaticResource IvoryBrush}"/>
                        <TextBlock Text="Check quietly in the background, download verified updates, and install them after Bookworm closes."
                                   Foreground="{StaticResource MutedOliveBrush}" FontSize="11"
                                   Margin="0,4,20,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox x:Name="AutomaticUpdatesToggle" Grid.Column="1" Style="{StaticResource AntiqueCheckBox}"
                              VerticalAlignment="Center" FontSize="15" Content="On"
                              Checked="AutomaticUpdatesToggle_Changed" Unchecked="AutomaticUpdatesToggle_Changed"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#60163429" BorderBrush="#6D5B37" BorderThickness="1"
                    CornerRadius="9" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Desktop Shortcut" FontSize="17" Foreground="{StaticResource IvoryBrush}"/>
                        <TextBlock Text="Create or repair a desktop shortcut using the official Bookworm icon."
                                   Foreground="{StaticResource MutedOliveBrush}" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ShortcutStatus" Foreground="{StaticResource Gold400Brush}"
                                   FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Make Shortcut" Style="{StaticResource GoldButton}"
                            Click="MakeShortcut_Click" VerticalAlignment="Center" Padding="14,8"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Margin="2,16,2,0" Foreground="{StaticResource MutedOliveBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       Text="The Update button on the bookshelf always performs a manual check, even when automatic updates are turned off."/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource GoldButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>