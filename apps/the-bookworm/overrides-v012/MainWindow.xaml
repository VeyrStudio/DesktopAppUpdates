<Window x:Class="TheBookworm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Bookworm" Width="1260" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="/Assets/TheBookworm.ico"
        Background="{StaticResource AntiqueGreenGradient}">
    <Grid Background="{StaticResource AntiqueGreenGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#081B14" BorderBrush="#725A31" BorderThickness="0,0,0,1" Padding="26,20,26,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="THE BOOKWORM" FontSize="33" FontWeight="Bold" Foreground="{StaticResource Gold300Brush}"/>
                        <TextBlock Text="  ✦" FontSize="19" Foreground="{StaticResource Gold600Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Read. Understand. Remember." FontSize="12" FontStyle="Italic" Foreground="{StaticResource MutedOliveBrush}" Margin="2,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#071A13" BorderBrush="#745B31" BorderThickness="1" CornerRadius="8" Height="42" Width="235" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource Gold400Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,2"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource IvoryBrush}" CaretBrush="{StaticResource Gold300Brush}" Padding="5,9,8,7" FontFamily="Georgia" FontSize="12" ToolTip="Search your bookshelf" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Content="+ Add Book" Style="{StaticResource GoldButton}" Click="AddBook_Click" Padding="16,9"/>
                    <Button Content="Update" Style="{StaticResource AntiqueButton}" Click="Update_Click"/>
                    <Button Content="Settings" Style="{StaticResource AntiqueButton}" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="4,0,4,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bookshelf" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="  ❦" FontSize="17" Foreground="{StaticResource Gold600Brush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VIEW" Style="{StaticResource SmallGoldLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <Button x:Name="CarouselViewButton" Content="↔  Carousel" ToolTip="Previous / current / next" Style="{StaticResource ViewButton}" Click="CarouselView_Click"/>
                    <Button x:Name="GridViewButton" Content="▦  Grid" ToolTip="Grid view" Style="{StaticResource ViewButton}" Click="GridView_Click"/>
                    <Button x:Name="VerticalViewButton" Content="↕  Vertical" ToolTip="Vertical list view" Style="{StaticResource ViewButton}" Click="VerticalView_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource ShelfGradient}" BorderBrush="{StaticResource Gold600Brush}" BorderThickness="1.5" CornerRadius="18" Padding="9" Effect="{StaticResource SoftShadow}">
                <Border Background="#071A13" BorderBrush="#5E4624" BorderThickness="1" CornerRadius="14" Padding="18">
                    <Grid>
                        <TextBlock Text="✦" Foreground="#72582E" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,-5,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="✦" Foreground="#72582E" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,1,0" IsHitTestVisible="False"/>
                        <TextBlock Text="✦" Foreground="#72582E" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,-5" IsHitTestVisible="False"/>
                        <TextBlock Text="✦" Foreground="#72582E" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,-5" IsHitTestVisible="False"/>

                        <Grid x:Name="EmptyState" Visibility="Collapsed">
                            <Border Width="470" MaxWidth="470" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Gold600Brush}" BorderThickness="1" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource GentleShadow}">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/bookworm-placeholder.jpg" Width="190" Height="245" Stretch="Uniform" Margin="0,0,0,18"/>
                                    <TextBlock Text="Your shelf is waiting." FontSize="24" Foreground="{StaticResource Gold300Brush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add your first book to begin." Foreground="{StaticResource MutedOliveBrush}" FontSize="12" Margin="0,7,0,13" HorizontalAlignment="Center"/>
                                    <Button Content="+ Add Book" Style="{StaticResource GoldButton}" Click="AddBook_Click" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="CarouselPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="PreviousButton" Style="{StaticResource ArrowButton}" Click="PreviousBook_Click" Content="←"/>
                                <TextBlock x:Name="PreviousTitle" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="92" MaxHeight="52" Foreground="{StaticResource MutedOliveBrush}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Gold500Brush}" BorderThickness="1.5" CornerRadius="17" Padding="9" Margin="18,12" MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource SoftShadow}">
                                <Border Background="#0A2119" BorderBrush="#5D4726" BorderThickness="1" CornerRadius="13" Padding="30">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="270"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#04100C" BorderBrush="#74582E" BorderThickness="1.5" CornerRadius="9" Padding="7" Width="250" Height="360" HorizontalAlignment="Center" Effect="{StaticResource GentleShadow}">
                                            <Image x:Name="CurrentCover" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="32,5,4,5" VerticalAlignment="Center" MinWidth="300">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                                <TextBlock Text="CURRENT BOOK" Style="{StaticResource SmallGoldLabel}"/>
                                                <TextBlock Text="  ✦" Foreground="{StaticResource Gold600Brush}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CurrentTitle" FontSize="31" LineHeight="36" FontWeight="SemiBold" Foreground="{StaticResource IvoryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="112"/>
                                            <TextBlock x:Name="CurrentAuthor" FontSize="14" FontStyle="Italic" Foreground="{StaticResource MutedOliveBrush}" Margin="0,9,0,21" TextWrapping="Wrap"/>
                                            <Border Height="1" Background="#6C532D" Margin="0,0,0,16"/>
                                            <TextBlock x:Name="CurrentLastChapter" FontSize="11" Foreground="{StaticResource Gold400Brush}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar x:Name="CurrentProgress" Height="6" Minimum="0" Maximum="1" Background="#03100B" Foreground="{StaticResource Gold500Brush}" Margin="0,0,0,22"/>
                                            <Button Content="Open Book  →" Style="{StaticResource GoldButton}" Click="OpenCurrentBook_Click" HorizontalAlignment="Left" Padding="18,9"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="NextButton" Style="{StaticResource ArrowButton}" Click="NextBook_Click" Content="→"/>
                                <TextBlock x:Name="NextTitle" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="92" MaxHeight="52" Foreground="{StaticResource MutedOliveBrush}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="GridPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="3">
                            <ItemsControl x:Name="GridBooks">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Style="{StaticResource AntiqueButton}" Click="BookCard_Click" Width="220" Height="350" Margin="11" Padding="10">
                                            <StackPanel>
                                                <Border Height="245" Background="#04100C" BorderBrush="#7B5D30" BorderThickness="1" CornerRadius="7" Padding="4" ClipToBounds="True">
                                                    <Image Source="{Binding CoverSource}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="5,10,5,2" Foreground="{StaticResource IvoryBrush}" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayAuthor}" FontStyle="Italic" FontSize="11" TextAlignment="Center" Foreground="{StaticResource MutedOliveBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer x:Name="VerticalPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="5">
                            <ItemsControl x:Name="VerticalBooks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Style="{StaticResource AntiqueButton}" Click="BookCard_Click" HorizontalContentAlignment="Stretch" Margin="8" Padding="13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="72" Height="104" Background="#04100C" BorderBrush="#776039" BorderThickness="1" CornerRadius="5" Padding="2" ClipToBounds="True">
                                                    <Image Source="{Binding CoverSource}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource IvoryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DisplayAuthor}" FontStyle="Italic" Foreground="{StaticResource MutedOliveBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="Open  →" Foreground="{StaticResource Gold300Brush}" VerticalAlignment="Center" Margin="10"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#06150F" BorderBrush="#594523" BorderThickness="0,1,0,0" Padding="28,8">
            <TextBlock x:Name="ShelfStatus" Foreground="{StaticResource MutedOliveBrush}" FontSize="10"/>
        </Border>
    </Grid>
</Window>