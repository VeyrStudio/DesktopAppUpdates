<Window x:Class="TheBookworm.BookWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Bookworm — Reader" Width="1460" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterOwner" Icon="/Assets/TheBookworm.ico"
        Background="{StaticResource AntiqueGreenGradient}">
    <Grid Background="{StaticResource AntiqueGreenGradient}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#081B14" BorderBrush="#725A31" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="←  Bookshelf" Style="{StaticResource AntiqueButton}" Click="Back_Click"/>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BookTitleText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Gold300Brush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BookAuthorText" FontStyle="Italic" Foreground="{StaticResource MutedOliveBrush}" FontSize="11" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Bookmark" Style="{StaticResource AntiqueButton}" Click="Bookmark_Click"/>
                    <Button Content="Save" Style="{StaticResource GoldButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" MinWidth="195"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*" MinWidth="510"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="286" MinWidth="245"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Gold600Brush}" BorderThickness="1" CornerRadius="12" Padding="10" Effect="{StaticResource GentleShadow}">
                <Border Background="#091F17" BorderBrush="#49371E" BorderThickness="1" CornerRadius="9" Padding="11">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="3,2,3,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CONTENTS" Style="{StaticResource SmallGoldLabel}"/>
                                <TextBlock Text="  ❦" Foreground="{StaticResource Gold600Brush}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="EntireBookCheck" Content="Entire Book" Style="{StaticResource AntiqueCheckBox}" FontWeight="SemiBold" Checked="EntireBookCheck_Changed" Unchecked="EntireBookCheck_Changed"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ChapterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" Tag="{Binding}" Style="{StaticResource AntiqueCheckBox}" Checked="ChapterCheck_Changed" Unchecked="ChapterCheck_Changed"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="#102D22"/>

            <Border Grid.Column="2" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Gold600Brush}" BorderThickness="1" CornerRadius="12" Padding="10" Effect="{StaticResource GentleShadow}">
                <TabControl x:Name="WorkspaceTabs">
                    <TabItem Header="Reader">
                        <Grid Margin="9">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FindBox" Style="{StaticResource AntiqueTextBox}" Height="37" ToolTip="Find in selected reading" KeyDown="FindBox_KeyDown"/>
                                <Button Grid.Column="1" Content="Find" Style="{StaticResource AntiqueButton}" Padding="12,6" Click="Find_Click"/>
                            </Grid>
                            <TextBox x:Name="ReaderText" Grid.Row="1" Style="{StaticResource PaperTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="16" SelectionBrush="#806B7F45">
                                <TextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Explain This" Click="ExplainSelection_Click"/>
                                        <MenuItem Header="Summarize This" Click="SummarizeSelection_Click"/>
                                        <MenuItem Header="Define This" Click="DefineSelection_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Add to Notes" Click="AddSelectionToNotes_Click"/>
                                        <MenuItem Header="Ask About This" Click="AskSelection_Click"/>
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Notes">
                        <TextBox x:Name="NotesText" Style="{StaticResource PaperTextBox}" Margin="9" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </TabItem>
                    <TabItem Header="Study Guides">
                        <TextBox x:Name="StudyGuidesText" Style="{StaticResource PaperTextBox}" Margin="9" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </TabItem>
                    <TabItem x:Name="QuestionsTab" Header="Questions">
                        <TextBox x:Name="QuestionsText" Style="{StaticResource PaperTextBox}" Margin="9" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </TabItem>
                    <TabItem x:Name="QuizzesTab" Header="Quizzes">
                        <TextBox x:Name="QuizzesText" Style="{StaticResource PaperTextBox}" Margin="9" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" Background="#102D22"/>

            <Border Grid.Column="4" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Gold600Brush}" BorderThickness="1" CornerRadius="12" Padding="10" Effect="{StaticResource GentleShadow}">
                <Border Background="#091F17" BorderBrush="#49371E" BorderThickness="1" CornerRadius="9" Padding="11">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="4,2,4,10">
                                <TextBlock Text="BOOKWORM TOOLS" Style="{StaticResource SmallGoldLabel}"/>
                                <TextBlock Text="  ❦" Foreground="{StaticResource Gold600Brush}" FontSize="11"/>
                            </StackPanel>
                            <Button Content="Summarize" Style="{StaticResource AntiqueButton}" Click="Summarize_Click" Margin="3,2"/>
                            <Button Content="Make Notes" Style="{StaticResource AntiqueButton}" Click="Notes_Click" Margin="3,2"/>
                            <Button Content="Key Concepts" Style="{StaticResource AntiqueButton}" Click="KeyConcepts_Click" Margin="3,2"/>
                            <Button Content="Definitions" Style="{StaticResource AntiqueButton}" Click="Definitions_Click" Margin="3,2"/>
                            <Button Content="Important Passages" Style="{StaticResource AntiqueButton}" Click="ImportantPassages_Click" Margin="3,2"/>
                            <Button Content="Chapter Outline" Style="{StaticResource AntiqueButton}" Click="Outline_Click" Margin="3,2"/>
                            <Button Content="Explain Simply" Style="{StaticResource AntiqueButton}" Click="Explain_Click" Margin="3,2"/>
                            <Button Content="Study Guide" Style="{StaticResource AntiqueButton}" Click="StudyGuide_Click" Margin="3,2"/>
                            <Button x:Name="ReviewQuestionsButton" Content="Review Questions" Style="{StaticResource AntiqueButton}" Click="ReviewQuestions_Click" Margin="3,2"/>
                            <Button x:Name="QuizButton" Content="Make a Quiz" Style="{StaticResource AntiqueButton}" Click="Quiz_Click" Margin="3,2"/>

                            <Border Height="1" Background="#6D522C" Margin="7,14"/>
                            <TextBlock Text="ASK BOOKWORM" Style="{StaticResource SmallGoldLabel}" Margin="4,0,4,7"/>
                            <TextBox x:Name="AskBox" Style="{StaticResource AntiqueTextBox}" Height="84" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Button Content="Ask Bookworm" Style="{StaticResource GoldButton}" Click="Ask_Click" Margin="4,7,4,3"/>
                            <TextBlock x:Name="ToolStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedOliveBrush}" FontSize="10" Margin="7,7,7,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>