{
  "name": "replay",
  "version": "0.3.1",
  "description": "Replay personal media archive",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "studio.veyr.replay",
    "productName": "Replay",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ReplaySetup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}