<Window x:Class="TheLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Library" Width="1420" Height="920" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#0C0B0A" Foreground="#EDE0C5"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#0C0B0A"/>
    <SolidColorBrush x:Key="DeepLeather" Color="#12100E"/>
    <SolidColorBrush x:Key="Leather" Color="#181512"/>
    <SolidColorBrush x:Key="RaisedLeather" Color="#211D19"/>
    <SolidColorBrush x:Key="Brass" Color="#B7954E"/>
    <SolidColorBrush x:Key="BrightBrass" Color="#D0AE66"/>
    <SolidColorBrush x:Key="DarkBrass" Color="#5B4828"/>
    <SolidColorBrush x:Key="Ivory" Color="#EDE0C5"/>
    <SolidColorBrush x:Key="Muted" Color="#B9A98A"/>
    <SolidColorBrush x:Key="Danger" Color="#B85B55"/>

    <LinearGradientBrush x:Key="GoldFace" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#D0AF69" Offset="0"/>
      <GradientStop Color="#A17C3E" Offset="0.5"/>
      <GradientStop Color="#80602D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#E0C17D" Offset="0"/>
      <GradientStop Color="#B68D47" Offset="0.55"/>
      <GradientStop Color="#8A6933" Offset="1"/>
    </LinearGradientBrush>

    <DrawingBrush x:Key="LeatherPattern" Viewport="0,0,26,26" ViewportUnits="Absolute" TileMode="Tile">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#12100E">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,26,26"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M 0,13 L 13,0 26,13 13,26 Z M 6.5,13 L 13,6.5 19.5,13 13,19.5 Z">
            <GeometryDrawing.Pen><Pen Brush="#28221C" Thickness="0.55"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.52" Color="#000000"/>
    <DropShadowEffect x:Key="GoldGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.18" Color="#C8A457"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ivory}"/></Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="0,5,0,3"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F0E0C"/>
      <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
      <Setter Property="CaretBrush" Value="{StaticResource BrightBrass}"/>
      <Setter Property="SelectionBrush" Value="#6B542D"/>
      <Setter Property="BorderBrush" Value="#5D4A2B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0F0E0C"/>
      <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
      <Setter Property="BorderBrush" Value="#5D4A2B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#17130F"/>
      <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,8"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource Brass}"/>
    </Style>

    <Style x:Key="ArchiveButton" TargetType="Button">
      <Setter Property="Background" Value="#11100E"/>
      <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
      <Setter Property="BorderBrush" Value="#63502E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#211B14"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brass}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#3A2D1C"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource ArchiveButton}">
      <Setter Property="Background" Value="{StaticResource GoldFace}"/>
      <Setter Property="Foreground" Value="#17120B"/>
      <Setter Property="BorderBrush" Value="#D2B267"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Effect" Value="{StaticResource GoldGlow}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border Margin="3" BorderBrush="#5F461F" BorderThickness="1" Opacity="0.45"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource GoldHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ArchiveButton}">
      <Setter Property="Foreground" Value="{StaticResource Danger}"/>
      <Setter Property="BorderBrush" Value="#6F312E"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ArchiveButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#332B20"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="20,14"/>
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="#D8C9AA"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="Foreground" Value="{StaticResource Brass}"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource LeatherPattern}"/>
      <Setter Property="BorderBrush" Value="#6A552F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
    </Style>
    <Style x:Key="InsetCard" TargetType="Border">
      <Setter Property="Background" Value="#0F0E0C"/>
      <Setter Property="BorderBrush" Value="#4F4028"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style x:Key="CoverCardButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ivory}"/>
      <Setter Property="BorderBrush" Value="#5A482A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#D1AD62"/>
                <Setter TargetName="Frame" Property="Effect" Value="{StaticResource GoldGlow}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource LeatherPattern}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="SidebarBorder" Grid.Column="0" Background="#11100E" BorderBrush="#715A31" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#443722" BorderThickness="0,0,0,1" Padding="16,14">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="30" Height="30" BorderBrush="{StaticResource Brass}" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0">
              <TextBlock Text="L" Style="{StaticResource Heading}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="The Library" Style="{StaticResource Heading}" FontSize="17"/>
              <TextBlock Text="PRIVATE ARCHIVE" Style="{StaticResource Eyebrow}" FontSize="8" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
          <Button Content="▤   All Covers" Style="{StaticResource NavButton}" Click="AllCovers_Click"/>
          <Button Content="✦   Fandoms" Style="{StaticResource NavButton}" Click="Fandoms_Click"/>
          <Button Content="∞   Ships" Style="{StaticResource NavButton}" Click="Ships_Click"/>
          <Button Content="◈   Complete Sets" Style="{StaticResource NavButton}" Click="CompleteSets_Click"/>
          <Button Content="◌   Incomplete Sets" Style="{StaticResource NavButton}" Click="IncompleteSets_Click"/>
          <Button Content="▣   Archive" Style="{StaticResource NavButton}" Click="Archived_Click"/>
          <Border Height="1" Background="#5B4828" Margin="18,14"/>
          <Button Content="＋   Add &amp; Edit Covers" Style="{StaticResource NavButton}" Click="AddCovers_Click"/>
          <Button Content="⚙   Settings &amp; Backup" Style="{StaticResource NavButton}" Click="Settings_Click"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#443722" BorderThickness="0,1,0,0" Padding="18,14">
          <TextBlock x:Name="SidebarStats" Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="11" TextWrapping="Wrap"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid x:Name="ArchivePage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Border Background="#11100E" BorderBrush="#4D3D24" BorderThickness="0,0,0,1" Padding="24,18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="ArchiveHeading" Text="The Library" Style="{StaticResource Heading}" FontSize="30"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <Border Width="70" Height="1" Background="{StaticResource DarkBrass}" VerticalAlignment="Center"/>
                  <TextBlock Text="◆" Foreground="{StaticResource Brass}" FontSize="8" Margin="8,0"/>
                  <TextBlock x:Name="ArchiveSubheading" Text="Grouped Sets" Foreground="{StaticResource Muted}" FontFamily="Georgia"/>
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="ResultCount" Grid.Column="2" Foreground="{StaticResource Muted}" FontFamily="Georgia" VerticalAlignment="Bottom" Margin="18,0,0,4"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,10,0" ToolTip="Search title, fandom, ship, tags, or filename" TextChanged="ArchiveFilter_Changed"/>
              <ComboBox x:Name="PositionFilter" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="ArchiveFilter_Changed">
                <ComboBoxItem Content="All Panels" IsSelected="True"/><ComboBoxItem Content="Front Cover"/><ComboBoxItem Content="Spine"/><ComboBoxItem Content="Back Cover"/><ComboBoxItem Content="Other"/>
              </ComboBox>
              <ComboBox x:Name="SortBox" Grid.Column="2" Margin="0,0,10,0" SelectionChanged="ArchiveFilter_Changed">
                <ComboBoxItem Content="Recently Added" IsSelected="True"/><ComboBoxItem Content="Title"/><ComboBoxItem Content="Fandom"/><ComboBoxItem Content="Ship"/>
              </ComboBox>
              <ComboBox x:Name="ViewMode" Grid.Column="3" Margin="0,0,10,0" SelectionChanged="ArchiveFilter_Changed">
                <ComboBoxItem Content="Grouped Sets" IsSelected="True"/><ComboBoxItem Content="All Images"/>
              </ComboBox>
              <Button Grid.Column="4" Content="＋  ADD COVERS" Style="{StaticResource GoldButton}" Click="AddCovers_Click"/>
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="330"/></Grid.ColumnDefinitions>
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="14">
            <Grid>
              <ItemsControl x:Name="CoverItems" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource CoverCardButton}" Margin="8" Width="196" Height="326" Tag="{Binding}" Click="CoverCard_Click"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                      <Grid Background="#13110F">
                        <Grid.RowDefinitions><RowDefinition Height="226"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="#090908" BorderBrush="#332B20" BorderThickness="0,0,0,1">
                          <Image Source="{Binding CoverImage}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="10,8,10,8">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="15" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Fandom}" Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="10" TextAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                          <Border Height="1" Background="#8B6D38" Margin="12,7,12,6"/>
                          <TextBlock Text="{Binding Ship}" Foreground="#D7C7A6" FontFamily="Georgia" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding PanelSummary}" Foreground="{StaticResource Brass}" FontSize="9" TextAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="ArchiveEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <TextBlock Text="No covers found" Style="{StaticResource Heading}" FontSize="24" HorizontalAlignment="Center"/>
                <TextBlock Text="Try another search or add a cover to the archive." Foreground="{StaticResource Muted}" Margin="0,8"/>
                <Button Content="ADD A COVER" Style="{StaticResource GoldButton}" Margin="40,12" Click="AddCovers_Click"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <Border Grid.Column="1" Background="#100F0D" BorderBrush="#6B552F" BorderThickness="1,0,0,0" Padding="14">
            <Border Style="{StaticResource SectionCard}" Padding="16">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="ARCHIVE RECORD" Style="{StaticResource Heading}" FontSize="20" HorizontalAlignment="Center"/>
                  <Border Height="1" Background="#745B31" Margin="20,10"/>
                  <Border Background="#080807" BorderBrush="#5B4828" BorderThickness="1" Height="220" Margin="0,2,0,12">
                    <Image x:Name="DetailImage" Stretch="Uniform"/>
                  </Border>
                  <TextBlock x:Name="DetailEmpty" Text="Select a cover or set to inspect it." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8" TextAlignment="Center"/>
                  <StackPanel x:Name="DetailEditor" IsEnabled="False">
                    <Label Content="TITLE"/><TextBox x:Name="DetailProject"/>
                    <Label Content="FANDOM" Margin="0,6,0,0"/><TextBox x:Name="DetailFandom"/>
                    <Label Content="SHIP" Margin="0,6,0,0"/><TextBox x:Name="DetailShip"/>
                    <Label Content="EXTRA TAGS" Margin="0,6,0,0"/><TextBox x:Name="DetailTags"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,5,0"><Label Content="PANEL"/><ComboBox x:Name="DetailPosition"><ComboBoxItem Content="Front Cover"/><ComboBoxItem Content="Spine"/><ComboBoxItem Content="Back Cover"/><ComboBoxItem Content="Other"/></ComboBox></StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0"><Label Content="TYPE"/><ComboBox x:Name="DetailType"><ComboBoxItem Content="Original"/><ComboBoxItem Content="FanFiction"/><ComboBoxItem Content="Unsorted"/></ComboBox></StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetailPieces" Foreground="{StaticResource Brass}" FontFamily="Georgia" FontSize="10" Margin="0,12" TextWrapping="Wrap"/>
                    <Button Content="EDIT / SAVE DETAILS" Style="{StaticResource GoldButton}" Margin="0,4" Click="SaveDetails_Click"/>
                    <Button Content="DOWNLOAD" Style="{StaticResource ArchiveButton}" Margin="0,6,0,0" Click="Download_Click"/>
                    <Button Content="REPLACE" Style="{StaticResource ArchiveButton}" Margin="0,6,0,0" Click="Replace_Click"/>
                    <Button x:Name="ArchiveButton" Content="ARCHIVE" Style="{StaticResource ArchiveButton}" Margin="0,6,0,0" Click="ArchiveSelected_Click"/>
                    <Button Content="DELETE" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="DeleteSelected_Click"/>
                    <TextBlock x:Name="AutosaveStatus" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8" HorizontalAlignment="Right"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0E0D0C" BorderBrush="#453722" BorderThickness="0,1,0,0" Padding="18,0">
          <TextBlock Text="The Library  •  Private cover archive" Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="10" VerticalAlignment="Center"/>
        </Border>
      </Grid>

      <Grid x:Name="AddPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0F0E0C" BorderBrush="#4D3D24" BorderThickness="0,0,0,1" Padding="28,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Content="←  Back to Library" Style="{StaticResource ArchiveButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,7" Click="AllCovers_Click"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock Text="ADD &amp; EDIT COVERS" Style="{StaticResource Heading}" FontSize="28" HorizontalAlignment="Center"/>
              <Border Height="1" Background="#70572E" Margin="40,7"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SingleModeButton" Content="SINGLE PANEL" Style="{StaticResource GoldButton}" Width="170" Margin="3" Click="SingleMode_Click"/>
                <Button x:Name="WrapModeButton" Content="FULL COVER WRAP" Style="{StaticResource ArchiveButton}" Width="170" Margin="3" Click="WrapMode_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
          <Grid x:Name="SinglePanel">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="UPLOAD QUEUE" Style="{StaticResource Heading}" FontSize="18" HorizontalAlignment="Center"/>
                  <Button Content="＋  ADD IMAGE" Style="{StaticResource ArchiveButton}" Margin="0,14,0,10" Click="ChooseSingle_Click"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource InsetCard}" Padding="12" Margin="0,4">
                  <StackPanel>
                    <TextBlock x:Name="SingleFileName" Text="No image selected" Foreground="{StaticResource Ivory}" FontFamily="Georgia" TextWrapping="Wrap"/>
                    <TextBlock Text="Single Panel" Foreground="{StaticResource Brass}" FontSize="10" Margin="0,5,0,0"/>
                    <TextBlock Text="Choose one front, spine, back, or other panel image." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="1 item at a time" Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="10" Margin="4,10,0,0"/>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="SINGLE PANEL PREVIEW" Style="{StaticResource Heading}" FontSize="18" HorizontalAlignment="Center"/>
                <Border Grid.Row="1" Background="#080807" BorderBrush="#4E3E25" BorderThickness="1" Margin="0,14">
                  <Grid>
                    <Image x:Name="SinglePreview" Stretch="Uniform" Margin="8"/>
                    <TextBlock x:Name="SinglePreviewEmpty" Text="Selected image preview" Foreground="{StaticResource Muted}" FontFamily="Georgia" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="COVER POSITION" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox x:Name="SinglePosition" Width="190"><ComboBoxItem Content="Front Cover" IsSelected="True"/><ComboBoxItem Content="Spine"/><ComboBoxItem Content="Back Cover"/><ComboBoxItem Content="Other"/></ComboBox>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="ARCHIVE DETAILS" Style="{StaticResource Heading}" FontSize="18" HorizontalAlignment="Center"/>
                  <Border Height="1" Background="#70572E" Margin="22,10"/>
                  <Label Content="TITLE"/><TextBox x:Name="SingleProject"/>
                  <Label Content="FANDOM" Margin="0,6,0,0"/><TextBox x:Name="SingleFandom"/>
                  <Label Content="SHIP" Margin="0,6,0,0"/><TextBox x:Name="SingleShip"/>
                  <Label Content="EXTRA TAGS" Margin="0,6,0,0"/><TextBox x:Name="SingleTags"/>
                  <Label Content="COVER TYPE" Margin="0,6,0,0"/>
                  <ComboBox x:Name="SingleType"><ComboBoxItem Content="Original"/><ComboBoxItem Content="FanFiction" IsSelected="True"/><ComboBoxItem Content="Unsorted"/></ComboBox>
                  <CheckBox x:Name="SingleRemoveSource" Content="Remove outside source after safe import" IsChecked="True"/>
                  <Button Content="SAVE" Style="{StaticResource GoldButton}" Margin="0,14,0,0" Click="SaveSingle_Click"/>
                  <TextBlock x:Name="SingleStatus" Foreground="{StaticResource Brass}" FontFamily="Georgia" FontSize="10" Margin="0,10" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <Grid x:Name="WrapPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="UPLOAD QUEUE" Style="{StaticResource Heading}" FontSize="18" HorizontalAlignment="Center"/>
                  <Button Content="＋  ADD IMAGES" Style="{StaticResource ArchiveButton}" Margin="0,14,0,10" Click="ChooseWraps_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <ItemsControl x:Name="WrapQueue" ItemsSource="{Binding WrapJobs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource NavButton}" Tag="{Binding}" Click="QueueJob_Click" Margin="0,3" Padding="10,9">
                            <StackPanel><TextBlock Text="{Binding FileName}" FontFamily="Georgia" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brass}" FontSize="9" Margin="0,3,0,0"/></StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WrapQueueEmpty" Text="No full wraps queued." Foreground="{StaticResource Muted}" FontFamily="Georgia" Margin="4,14" TextWrapping="Wrap"/>
                  </Grid>
                </ScrollViewer>
                <Button Grid.Row="2" Content="CLEAR QUEUE" Style="{StaticResource ArchiveButton}" Margin="0,10,0,0" Click="ClearWraps_Click"/>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="SPLIT FULL COVER WRAP" Style="{StaticResource Heading}" FontSize="18"/><TextBlock x:Name="WrapEditorTitle" Text="Select a queued wrap" Foreground="{StaticResource Brass}" FontFamily="Georgia" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="FIT" Style="{StaticResource ArchiveButton}" Padding="10,5" Margin="2" Click="FitZoom_Click"/><Button Content="100%" Style="{StaticResource ArchiveButton}" Padding="10,5" Margin="2" Click="ActualZoom_Click"/></StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="165"/></Grid.RowDefinitions>
                  <ScrollViewer x:Name="WrapPreviewScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#080807">
                    <Grid x:Name="WrapImageSurface" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Image x:Name="WrapSourcePreview" Stretch="Uniform"/>
                      <Canvas x:Name="GuideCanvas" Background="Transparent" SizeChanged="GuideCanvas_SizeChanged">
                        <Thumb x:Name="LeftGuide" Width="8" Cursor="SizeWE" DragDelta="LeftGuide_DragDelta"><Thumb.Template><ControlTemplate><Border Background="#D9B15E" Opacity="0.92"/></ControlTemplate></Thumb.Template></Thumb>
                        <Thumb x:Name="RightGuide" Width="8" Cursor="SizeWE" DragDelta="RightGuide_DragDelta"><Thumb.Template><ControlTemplate><Border Background="#D9B15E" Opacity="0.92"/></ControlTemplate></Thumb.Template></Thumb>
                      </Canvas>
                    </Grid>
                  </ScrollViewer>
                  <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><Label Content="BACK / SPINE EDGE"/><Slider x:Name="LeftSlider" Minimum="1" ValueChanged="GuideSlider_Changed"/><TextBox x:Name="LeftPixels" TextChanged="GuidePixels_Changed"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><Label Content="SPINE / FRONT EDGE"/><Slider x:Name="RightSlider" Minimum="2" ValueChanged="GuideSlider_Changed"/><TextBox x:Name="RightPixels" TextChanged="GuidePixels_Changed"/></StackPanel>
                  </Grid>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource InsetCard}" Margin="2"><Image x:Name="BackPreview" Stretch="Uniform"/></Border>
                    <Border Grid.Column="1" Style="{StaticResource InsetCard}" Margin="2"><Image x:Name="SpinePreview" Stretch="Uniform"/></Border>
                    <Border Grid.Column="2" Style="{StaticResource InsetCard}" Margin="2"><Image x:Name="FrontPreview" Stretch="Uniform"/></Border>
                  </Grid>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="GuideSummary" Foreground="{StaticResource Brass}" FontFamily="Georgia" FontSize="10"/>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="ARCHIVE DETAILS" Style="{StaticResource Heading}" FontSize="18" HorizontalAlignment="Center"/>
                  <Border Height="1" Background="#70572E" Margin="22,10"/>
                  <Label Content="TITLE"/><TextBox x:Name="WrapProject" TextChanged="WrapMetadata_Changed"/>
                  <Label Content="FANDOM" Margin="0,6,0,0"/><TextBox x:Name="WrapFandom" TextChanged="WrapMetadata_Changed"/>
                  <Label Content="SHIP" Margin="0,6,0,0"/><TextBox x:Name="WrapShip" TextChanged="WrapMetadata_Changed"/>
                  <Label Content="EXTRA TAGS" Margin="0,6,0,0"/><TextBox x:Name="WrapTags" TextChanged="WrapMetadata_Changed"/>
                  <Label Content="COVER TYPE" Margin="0,6,0,0"/>
                  <ComboBox x:Name="WrapType" SelectionChanged="WrapMetadata_Changed"><ComboBoxItem Content="Original"/><ComboBoxItem Content="FanFiction" IsSelected="True"/><ComboBoxItem Content="Unsorted"/></ComboBox>
                  <CheckBox x:Name="WrapRemoveSource" Content="Remove source wrap after saving panels" IsChecked="True"/>
                  <Button Content="SAVE" Style="{StaticResource GoldButton}" Margin="0,12,0,0" Click="SaveCurrentWrap_Click"/>
                  <Button Content="REMOVE FROM QUEUE" Style="{StaticResource ArchiveButton}" Margin="0,7,0,0" Click="RemoveCurrentWrap_Click"/>
                  <TextBlock x:Name="WrapStatus" Foreground="{StaticResource Brass}" FontFamily="Georgia" FontSize="10" TextWrapping="Wrap" Margin="0,10"/>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#0D0C0B" BorderBrush="#4D3D24" BorderThickness="0,1,0,0" Margin="-10,10,-10,-10" Padding="18,9">
              <Grid>
                <TextBlock Text="Full wrap is temporary — Back, Spine, and Front are saved separately." Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="CLEAR ALL" Style="{StaticResource ArchiveButton}" Width="130" Margin="4,0" Click="ClearWraps_Click"/>
                  <Button Content="SAVE ALL" Style="{StaticResource GoldButton}" Width="190" Margin="4,0" Click="SaveAllWraps_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <Border Background="#11100E" BorderBrush="#4D3D24" BorderThickness="0,0,0,1" Padding="38,22">
          <StackPanel>
            <TextBlock Text="SETTINGS" Style="{StaticResource Heading}" FontSize="32"/>
            <TextBlock Text="Personalize and protect your archive." Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="14" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <Border Width="95" Height="1" Background="{StaticResource DarkBrass}" VerticalAlignment="Center"/>
              <TextBlock Text="◆" Foreground="{StaticResource Brass}" FontSize="8" Margin="8,0"/>
              <Border Width="95" Height="1" Background="{StaticResource DarkBrass}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Padding="30,24" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,10" MinHeight="250">
              <StackPanel>
                <TextBlock Text="BACKUP &amp; RESTORE" Style="{StaticResource Heading}" FontSize="21"/>
                <TextBlock Text="Backups include saved cover panels and archive information." Foreground="{StaticResource Muted}" FontFamily="Georgia" TextWrapping="Wrap" Margin="0,14,0,10"/>
                <Border Height="1" Background="#5B4828" Margin="0,8"/>
                <TextBlock x:Name="BackupStatus" Foreground="{StaticResource Brass}" FontFamily="Georgia" TextWrapping="Wrap" Margin="0,8"/>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button Content="EXPORT BACKUP" Style="{StaticResource GoldButton}" Margin="0,0,6,0" Click="ExportBackup_Click"/>
                  <Button Grid.Column="1" Content="IMPORT BACKUP" Style="{StaticResource GoldButton}" Margin="6,0,0,0" Click="RestoreBackup_Click"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="10,0,0,10" MinHeight="250">
              <StackPanel>
                <TextBlock Text="UPDATES" Style="{StaticResource Heading}" FontSize="21"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Ivory}" FontFamily="Georgia" Margin="0,18,0,6"/>
                <TextBlock Text="The Library checks its own independent update channel." Foreground="{StaticResource Muted}" FontFamily="Georgia" TextWrapping="Wrap"/>
                <Border Height="1" Background="#5B4828" Margin="0,16,0,10"/>
                <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource Brass}" FontFamily="Georgia" TextWrapping="Wrap" Margin="0,6"/>
                <Button Content="CHECK FOR UPDATES" Style="{StaticResource GoldButton}" Margin="0,14,0,0" Click="CheckUpdates_Click"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}" Margin="0,10,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="STORAGE" Style="{StaticResource Heading}" FontSize="21"/>
                  <TextBlock Text="Your covers and metadata live separately from the app so updates cannot overwrite them." Foreground="{StaticResource Muted}" FontFamily="Georgia" TextWrapping="Wrap" Margin="0,12,0,10"/>
                  <TextBox x:Name="StoragePath" IsReadOnly="True"/>
                </StackPanel>
                <Button Grid.Column="1" Content="OPEN DATA FOLDER" Style="{StaticResource GoldButton}" Width="210" Margin="24,0,0,0" VerticalAlignment="Center" Click="OpenStorage_Click"/>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#0E0D0C" BorderBrush="#453722" BorderThickness="0,1,0,0" Padding="18,0">
          <TextBlock Text="Settings and archive data are stored automatically." Foreground="{StaticResource Muted}" FontFamily="Georgia" FontSize="10" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>